for pr in grps do
  G := pr[1];
  if not IsPermGroup(G) then G := Image(IsomorphismPermGroup(G)); fi;
  Print(pr[2], " |G|=", Size(G), "\n");
  r := Check2126b(G, 500);
  Print(pr[2], " |G|=", Size(G), " ok=", r[1], " (", r[3], ")\n");
od;
