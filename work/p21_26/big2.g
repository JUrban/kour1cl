Read("/project/work/p21_26/check2.g");
AGLnq := function(n,q) local g; g := Filtered(AllPrimitiveGroups(NrMovedPoints, q^n, Size, q^n*Size(GL(n,q))), x -> IsElementaryAbelian(Socle(x)) and Size(Socle(x)) = q^n); return g[1]; end;
